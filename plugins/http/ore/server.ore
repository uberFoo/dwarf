use std::dwarf::Plugin;
use std::option::Option;
use std::result::Result;

struct HttpServer {
    // This plugin value must point to a valid plugin. The first part of the
    // path is the name, and the second part is a parameter to send to the
    // constructor.
    #[proxy(plugin = "http::http_server")]
    inner: Plugin<HttpServer>,
}

impl HttpServer {
    fn new() -> Self {
        HttpServer {
            inner: Plugin::<HttpServer>::new(),
        }
    }

    async fn serve(self, port: int) -> Future<()> {
        self.inner
            .invoke_func("http_server", "HttpServer", "serve", [port])
    }

    fn route(
        self,
        path: string,
        method: Method,
        body: Body,
        lambda: fn(Request) -> string,
    ) {
        // We need this function to create a Request instance from the returned int.
        let wrapper = |req: int| -> string {
            let req = Request { plugin: self.inner, inner: req };
            lambda(req)
        };

        self.inner
            .invoke_func("http_server", "HttpServer", "route", @[path, method.to_string(), body.to_string(), wrapper]);
    }
}

enum Method {
    Get,
    Post,
    Put,
    Delete,
}

impl Method {
    fn to_string(self) -> string {
        match self {
            Method::Get => "GET",
            Method::Post => "POST",
            Method::Put => "PUT",
            Method::Delete => "DELETE",
        }
    }
}

enum Body {
    Text,
    Json,
}

impl Body {
    fn to_string(self) -> string {
        match self {
            Body::Text => "text",
            Body::Json => "json",
        }
    }
}


struct Request {
    #[proxy(plugin = "http::http_server")]
    plugin: Plugin<HttpServer>,
    inner: int,
}

impl Request {
    fn uri(self) -> Uri {
        let uri = self
            .plugin
            .invoke_func("http_server", "Request", "uri", [self.inner]);
        Uri {
            inner: uri,
            plugin: self.plugin,
        }
    }
}

struct Uri {
    #[proxy(plugin = "http::http_server")]
    plugin: Plugin<HttpServer>,
    inner: int,
}

impl Uri {
    fn path(self) -> string {
        self.plugin
            .invoke_func("http_server", "Uri", "path", [self.inner])
    }
}

use std::dwarf::Plugin;
use std::option::Option;
use std::result::Result;

struct HttpServer {
    // This plugin value must point to a valid plugin. The first part of the
    // path is the name, and the second part is a parameter to send to the
    // constructor.
    #[proxy(plugin = "http::server")]
    inner: Plugin<HttpServer>,
}

impl HttpServer {
    fn new() -> Self {
        HttpServer {
            inner: Plugin::<HttpServer>::new(),
        }
    }

    async fn serve(self, port: int) -> Future<()> {
        self.inner
            .invoke_func("server", "HttpServer", "serve", [port])
    }

    fn route(
        self,
        path: string,
        method: Method,
        body: Body,
        lambda: fn(Request) -> string,
    ) {
        // We need this function to create a Request instance from the returned int.
        let wrapper = |req: int| -> string {
            let req = Request { plugin: self.inner, inner: req };
            lambda(req)
        };

        self.inner
            .invoke_func("server", "HttpServer", "route", @[path, method.to_string(), body.to_string(), wrapper]);
    }

    fn use_tls(self, cert: string, key: string) {
        self.inner
            .invoke_func("server", "HttpServer", "use_tls", [cert, key]);
    }

    fn prefix_route(
        self,
        path: string,
        method: Method,
        body: Body,
        lambda: fn(Request, string) -> string,
    ) {
        // We need this function to create a Request instance from the returned int.
        let wrapper = |req: int, suffix: int| -> string {
            let req = Request { plugin: self.inner, inner: req };
            let suffix = Suffix { plugin: self.inner, inner: suffix };
            lambda(req, suffix)
        };

        self.inner
            .invoke_func("server", "HttpServer", "prefix_route", @[path, method.to_string(), body.to_string(), wrapper]);
    }

    fn use_tls(self, cert: string, key: string) {
        self.inner
            .invoke_func("server", "HttpServer", "use_tls", [cert, key]);
    }
}

enum Method {
    Get,
    Post,
    Put,
    Delete,
}

impl Method {
    fn to_string(self) -> string {
        match self {
            Method::Get => "GET",
            Method::Post => "POST",
            Method::Put => "PUT",
            Method::Delete => "DELETE",
        }
    }
}

enum Body {
    Text,
    Json,
}

impl Body {
    fn to_string(self) -> string {
        match self {
            Body::Text => "text",
            Body::Json => "json",
        }
    }
}


struct Request {
    #[proxy(plugin = "http::server")]
    plugin: Plugin<HttpServer>,
    inner: int,
}

impl Request {
    fn uri(self) -> Uri {
        let uri = self
            .plugin
            .invoke_func("server", "Request", "uri", [self.inner]);
        Uri {
            inner: uri,
            plugin: self.plugin,
        }
    }
}

struct Uri {
    #[proxy(plugin = "http::server")]
    plugin: Plugin<HttpServer>,
    inner: int,
}

impl Uri {
    fn path(self) -> string {
        self.plugin
            .invoke_func("server", "Uri", "path", [self.inner])
    }

    fn query(self) -> Option<string> {
        let query: string = self.plugin
            .invoke_func("server", "Uri", "query", [self.inner]);
        if query.len() == 0 {
            Option::None
        } else {
            Option::Some(query)
        }
    }
}

struct Suffix {
    #[proxy(plugin = "http::server")]
    plugin: Plugin<HttpServer>,
    inner: int,
}

impl Suffix {
    fn to_string(self) -> string {
        self.plugin
            .invoke_func("server", "Suffix", "to_string", [self.inner])
    }
}
use std::dwarf::Plugin;
use std::result::Result;

struct Sqlx {
    #[proxy(plugin = "sqlx:foo")]
    plugin: Plugin<Sqlx>,
}

impl Sqlx {
    fn new() -> Self {
        Sqlx {
            plugin: Plugin::<Sqlx>::new(),
        }
    }

    async fn connect(self, connection_string: string) -> Future<Result<Pool, Error>> {
        let pool = self
            .plugin
            .invoke_func_mut("sqlx", "Sqlx", "connect", [connection_string]);

        match pool {
            Result::Ok(pool) => Result::<Pool, Error>::Ok(Pool {
                plugin: self.plugin,
                inner: pool,
            }),
            Result::Err(e) => Result::<Pool, Error>::Err(Error {
                plugin: self.plugin,
                inner: e,
            }),
        }
    }
}

enum Type {
    Integer,
    String,
}

struct Row {
    #[proxy(plugin = "sqlx")]
    plugin: Plugin<Sqlx>,
    inner: int,
}

impl Row {
    fn get<T>(self, index: int, ty: Type) -> T {
        self.plugin.invoke_func("sqlx", "Row", "get", @[self.inner, index, ty])
    }
}

struct Pool {
    #[proxy(plugin = "sqlx")]
    plugin: Plugin<Sqlx>,
    inner: int,
}

impl Pool {
    // fn query<F>(self, query: string, func: fn(Row) -> F) -> Result<[Row], Error> {
    fn query<F>(self, query: string, func: F) -> Result<[Row], Error> {
        let bounce = |row: int| {
            let row = Row {
                plugin: self.plugin,
                inner: row,
            };
            func(row)
        };

        let rows = self
            .plugin
            .invoke_func("sqlx", "Pool", "query", @[query, self.inner, bounce]);

        match rows {
            Result::Ok(rows) => Result::<[Row], Error>::Ok(rows),
            Result::Err(e) => Result::<[Row], Error>::Err(e),
        }
    }
}
struct Error {
    #[proxy(plugin = "sqlx")]
    plugin: Plugin<Sqlx>,
    inner: int,
}

use std::dwarf::Plugin;
use std::result::Result;

struct Md {
    #[proxy(plugin = "md")]
    inner: Plugin<Md>,
}

impl Md {
    fn new(theme: string) -> Self {
        Md {
            inner: Plugin::<Md>::new(theme),
        }
    }

    fn to_html(self, input: string) -> string {
        self.inner.invoke_func("md", "Md", "to_html", [input])
    }
}

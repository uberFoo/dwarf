enum Result<T, E> {
    Ok(T),
    Err(E),
}

impl Result<T, E> {
    fn is_ok(self) -> bool {
        match self {
            Result::Ok(_) => true,
            Result::Err(_) => false,
        }
    }

    fn is_err(self) -> bool {
        match self {
            Result::Ok(_) => false,
            Result::Err(_) => true,
        }
    }

    fn unwrap<T>(self) -> T {
        match self {
            Result::Ok(value) => value,
            Result::Err(_) => halt("called `Result::unwrap()` on an `Err` value"),
        }
    }
}

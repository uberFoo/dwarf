use std::dwarf::Plugin;
use std::result::Result;

struct Var {
    #[proxy(plugin = "std::env")]
    plugin: Plugin<Var>,
}

impl Var {
    fn var(name: string) -> Result<string, Error> {
        let plugin = Plugin::<Var>::new();
        plugin.invoke_func("env", "Var", "var", [name])
    }

    fn set_var(key: string, value: string) {
        let plugin = Plugin::<Var>::new();
        plugin.invoke_func("env", "Var", "set_var", [key, value])
    }
}

struct Error {
    #[proxy(plugin = "std::env")]
    plugin: Plugin<Error>,
    handle: int,
}

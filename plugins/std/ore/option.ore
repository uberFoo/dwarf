enum Option<T> {
    None,
    Some(T),
}

impl Option<T> {
    fn is_some(self) -> bool {
        match self {
            Option::Some(_) => true,
            Option::None => false,
        }
    }

    fn is_none(self) -> bool {
        match self {
            Option::Some(_) => false,
            Option::None => true,
        }
    }
    fn unwrap<T>(self) -> T {
        match self {
            Option::Some(value) => value,
            Option::None => halt("called `Option::unwrap()` on `None`"),
        }
    }
}

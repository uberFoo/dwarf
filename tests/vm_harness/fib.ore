fn fib(n: int) -> int {
    if n <= 1 {
        n
    } else {
        fib(n - 1) + fib(n - 2)
    }
}

fn main() -> int {
    let n = 5;
    print("Calculating fibonacci number ${n}:\n");
    let result = fib(n as int);
    print(result as string + "\n");
    chacha::assert_eq(result, 5);
    result
}

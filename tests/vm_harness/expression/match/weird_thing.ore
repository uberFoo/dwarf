use std::dwarf::Plugin;
use std::result::Result;

use sqlx::Error;
use sqlx::Pool;

struct Sqlx {
    #[proxy(plugin = "sqlx")]
    plugin: Plugin<Sqlx>,
}

impl Sqlx {
    fn new() -> Self {
        Sqlx {
            plugin: Plugin::<Sqlx>::new(),
        }
    }

    async fn connect(self, connection_string: string) -> Future<Result<Pool, Error>> {
        let pool = self
            .plugin
            .invoke_func_mut("sqlx", "Sqlx", "connect", [connection_string]);

        match pool {
            Result::Ok(pool) => Result::<Pool, Error>::Ok(Pool {
                plugin: self.plugin,
                inner: pool,
            }),
            Result::Err(e) => Result::<Pool, Error>::Err(Error {
                plugin: self.plugin,
                inner: e,
            }),
        }
    }
}

async fn main() -> Future<()> {
    let sqlx = Sqlx::new();
    let db = "postgres://postgres:postgres@localhost/bogus";

    sqlx.connect(db).await;

    chacha::assert(true);

    ()
}

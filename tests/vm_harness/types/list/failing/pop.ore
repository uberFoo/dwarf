use std::option::Option;

fn main() {
    let list = [1, 2, 3, 4];
    let test = list.pop();
    chacha::assert_eq(list.len(), 3);
    chacha::assert_eq(test, Option::Some(4));

    let any_list = @[1, "hello"];
    let test = any_list.pop();
    chacha::assert_eq(any_list.len(), 2);
    chacha::assert_eq(test, Option::Some("hello"));
}
use std::fs::Error;
use std::fs::File;
use std::result::Result;

fn main() {
    let file = File::open("tests/vm_harness/extensions/std/test.txt");

    match file {
        Result::<File, Error>::Ok(file) => {
            print("File opened successfully: ${file}\n");
            let result = file.read();
            print(result as string + "\n");
            if let Result::<string, Error>::Ok(result) = result {
                chacha::assert_eq(result, "42");
            } else {
                chacha::assert(false);
            }
        }
        Result::<File, Error>::Err(error) => print("Failed to open file: ${error}"),
    };
}
